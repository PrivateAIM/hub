{
    "name": "@privateaim/errors",
    "type": "module",
    "version": "0.20.1",
    "description": "Hub error codes, a root HubError class, typed subclasses, a code-to-HTTP-status table and guards.",
    "license": "Apache-2.0",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build:js": "rimraf ./dist && tsdown",
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build": "npm run build:js && npm run build:types"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "admin@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "dependencies": {
        "@ebec/core": "^1.3.2"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26.0.0"
    }
}
