{
    "name": "@privateaim/server-db-kit",
    "type": "module",
    "version": "0.20.0",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "files": [
        "dist"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://tada5hi.net"
    },
    "license": "Apache-2.0",
    "description": "TypeORM helpers for FLAME Hub services: UTC-pinned options, boot locks, a tagged read cache and event subscribers.",
    "dependencies": {
        "@authup/kit": "^1.0.0-beta.77",
        "@privateaim/kit": "^0.20.0",
        "@privateaim/server-kit": "^0.20.0",
        "@rapiq/cache": "^0.2.1",
        "@rapiq/core": "^2.5.1"
    },
    "devDependencies": {
        "cross-env": "^10.1.0",
        "typeorm": "^1.1.3",
        "typeorm-extension": "^4.6.0",
        "unplugin-swc": "^2.0.0",
        "vitest": "^5.1.1"
    },
    "peerDependencies": {
        "typeorm": "^1.1.3",
        "typeorm-extension": "^4.6.0"
    },
    "scripts": {
        "build:js": "rimraf ./dist && tsdown",
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build": "npm run build:js && npm run build:types",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts"
    },
    "engines": {
        "node": ">=26.0.0"
    }
}
