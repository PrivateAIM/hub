{
    "name": "@privateaim/server-realtime-kit",
    "type": "module",
    "version": "0.20.1",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "files": [
        "dist"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://tada5hi.net"
    },
    "license": "Apache-2.0",
    "description": "Socket.IO helpers for FLAME Hub services: a Redis-adapted server, Authup socket authentication and room subscriptions.",
    "dependencies": {
        "@authup/access": "^1.0.0-beta.77",
        "@authup/core-http-kit": "^1.0.0-beta.77",
        "@authup/core-kit": "^1.0.0-beta.77",
        "@authup/core-realtime-kit": "^1.0.0-beta.77",
        "@authup/kit": "^1.0.0-beta.77",
        "@authup/server-adapter-kit": "^1.0.0-beta.77",
        "@authup/server-adapter-socket-io": "^1.0.0-beta.77",
        "@authup/server-kit": "^1.0.0-beta.77",
        "@authup/specs": "^1.0.0-beta.77",
        "@privateaim/errors": "^0.20.1",
        "@privateaim/kit": "^0.20.1",
        "@privateaim/server-kit": "^0.20.1",
        "@privateaim/telemetry-kit": "^0.20.1",
        "@socket.io/redis-adapter": "^8.3.0"
    },
    "devDependencies": {
        "redis-extension": "^3.0.0",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4",
        "vitest": "^5.1.1"
    },
    "peerDependencies": {
        "redis-extension": "^3.0.0",
        "socket.io": "^4.8.4"
    },
    "scripts": {
        "dev": "ts-node src/index.ts",
        "build:js": "rimraf ./dist && tsdown",
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build": "npm run build:js && npm run build:types",
        "start": "node dist/index.mjs",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts"
    },
    "engines": {
        "node": ">=26.0.0"
    }
}
