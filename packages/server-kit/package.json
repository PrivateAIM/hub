{
    "name": "@privateaim/server-kit",
    "type": "module",
    "version": "0.20.1",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "files": [
        "dist"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://tada5hi.net"
    },
    "license": "Apache-2.0",
    "description": "Shared foundation of the FLAME Hub services: DI modules, startup, health, logging, message bus, cache and Authup.",
    "scripts": {
        "build:js": "rimraf ./dist && tsdown",
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build": "npm run build:js && npm run build:types",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts",
        "test:coverage": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts --coverage"
    },
    "dependencies": {
        "@authup/core-http-kit": "^1.0.0-beta.77",
        "@authup/core-kit": "^1.0.0-beta.77",
        "@authup/server-kit": "^1.0.0-beta.77",
        "@authup/specs": "^1.0.0-beta.77",
        "@hapic/oauth2": "^4.2.0",
        "@hubwire/amqp": "^0.2.3",
        "@privateaim/errors": "^0.20.1",
        "@privateaim/kit": "^0.20.1",
        "@rapiq/cache": "^0.2.1",
        "@rapiq/cache-redis": "^0.1.3",
        "@rapiq/core": "^2.5.1",
        "@socket.io/redis-emitter": "^5.1.0",
        "eldin": "^1.3.0",
        "envix": "^1.5.0",
        "hapic": "^3.1.0",
        "hubwire": "^0.2.3",
        "orkos": "^1.1.1",
        "triple-beam": "^1.4.1",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0"
    },
    "devDependencies": {
        "@authup/access": "^1.0.0-beta.77",
        "@authup/server-test-kit": "^1.0.0-beta.77",
        "@hubwire/test": "^0.1.3",
        "redis-extension": "^3.0.0",
        "typeorm-extension": "^4.6.0",
        "vitest": "^5.1.1"
    },
    "peerDependencies": {
        "@authup/access": "^1.0.0-beta.77",
        "redis-extension": "^3.0.0",
        "typeorm-extension": "^4.6.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26.0.0"
    }
}
