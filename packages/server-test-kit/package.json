{
    "name": "@privateaim/server-test-kit",
    "type": "module",
    "version": "0.20.0",
    "license": "Apache-2.0",
    "description": "Test fakes and Testcontainers helpers for FLAME Hub services: in-memory repositories, actors, Authup and databases.",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./setup": {
            "types": "./dist/setup.d.mts",
            "import": "./dist/setup.mjs"
        }
    },
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "files": [
        "dist"
    ],
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://tada5hi.net"
    },
    "devDependencies": {
        "@authup/access": "^1.0.0-beta.77",
        "@authup/core-http-kit": "^1.0.0-beta.77",
        "@authup/core-kit": "^1.0.0-beta.77",
        "@authup/server-test-kit": "^1.0.0-beta.77",
        "@privateaim/core-http-kit": "^0.20.0",
        "@privateaim/server-kit": "^0.20.0",
        "@rapiq/adapter-memory": "^2.5.1",
        "@rapiq/core": "^2.5.1",
        "hapic": "^3.1.0",
        "testcontainers": "^12.2.2",
        "typeorm": "^1.1.3",
        "typeorm-extension": "^4.6.0",
        "vitest": "^5.1.1"
    },
    "peerDependencies": {
        "@authup/access": "^1.0.0-beta.77",
        "@authup/core-http-kit": "^1.0.0-beta.77",
        "@authup/core-kit": "^1.0.0-beta.77",
        "@authup/server-test-kit": "^1.0.0-beta.77",
        "@privateaim/core-http-kit": "^0.20.0",
        "@privateaim/server-kit": "^0.20.0",
        "@rapiq/adapter-memory": "^2.5.1",
        "@rapiq/core": "^2.5.1",
        "hapic": "^3.1.0",
        "typeorm": "^1.1.3",
        "typeorm-extension": "^4.6.0"
    },
    "scripts": {
        "build:js": "rimraf ./dist && tsdown",
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build": "npm run build:js && npm run build:types",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26.0.0"
    }
}
