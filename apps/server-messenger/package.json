{
    "name": "@privateaim/server-messenger",
    "type": "module",
    "version": "0.20.0",
    "private": true,
    "module": "./dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        }
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://tada5hi.net"
    },
    "license": "Apache-2.0",
    "description": "Durable store-and-forward message broker of FLAME Hub, with REST send, pull and ack and a push wakeup.",
    "dependencies": {
        "@authup/core-kit": "^1.0.0-beta.77",
        "@authup/kit": "^1.0.0-beta.77",
        "@privateaim/errors": "^0.20.0",
        "@privateaim/kit": "^0.20.0",
        "@privateaim/messenger-kit": "^0.20.0",
        "@privateaim/server-db-kit": "^0.20.0",
        "@privateaim/server-http-kit": "^0.20.0",
        "@privateaim/server-kit": "^0.20.0",
        "@privateaim/server-realtime-kit": "^0.20.0",
        "@privateaim/server-telemetry-kit": "^0.20.0",
        "@privateaim/telemetry-kit": "^0.20.0",
        "@routup/basic": "^3.1.0",
        "@routup/decorators": "^5.4.0",
        "@validup/zod": "^2.0.3",
        "citty": "^0.2.2",
        "dotenv": "^18.0.10",
        "eldin": "^1.3.0",
        "envix": "^2.0.1",
        "hapic": "^3.1.0",
        "hubwire": "^0.2.3",
        "mysql2": "^3.24.6",
        "orkos": "^1.1.1",
        "pg": "^8.23.1",
        "redis-extension": "^3.0.0",
        "reflect-metadata": "^0.2.2",
        "routup": "^6.5.0",
        "socket.io": "^4.8.4",
        "typeorm": "^1.1.3",
        "typeorm-extension": "^4.6.0",
        "validup": "^2.0.2",
        "zod": "^4.6.7"
    },
    "scripts": {
        "cli": "node dist/cli/index.mjs",
        "cli-dev": "ts-node src/cli/index.ts",
        "build:js": "tsdown",
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build": "rimraf dist/ && npm run build:js && npm run build:types",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts",
        "test:schema-drift": "node scripts/assert-schema-drift.mjs"
    },
    "devDependencies": {
        "@privateaim/messenger-http-kit": "^0.20.0",
        "@privateaim/server-test-kit": "^0.20.0",
        "better-sqlite3": "^13.2.0",
        "vitest": "^5.1.1"
    },
    "engines": {
        "node": ">=26.0.0"
    }
}
